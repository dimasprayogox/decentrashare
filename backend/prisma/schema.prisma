// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PrivacyLevel {
  PRIVATE
  PUBLIC
  LINK_ONLY
  SPECIFIC_USER
}

enum AccessRoleFolder {
  VIEWER
  EDITOR
}

model User {
  id              String    @id @default(uuid())
  walletAddress   String    @unique
  username        String?   @unique
  email           String?   @unique
  avatarUrl       String?
  bio             String?
  website         String? 
  role            Role      @default(USER)
  isRegistered    Boolean   @default(false)
  nonce           String?
  nonceExpiresAt  DateTime?
  refreshToken    String?
  lastActive      DateTime? @default(now())
  preferences     Json?     @default("{}") 

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pinataGroupId   String?  
  
  documents       Document[]
  folders         Folder[]
  sharedDocuments DocumentAccess[]
  sharedFolders   FolderAccess[]
  activityLogs    ActivityLog[]


  @@map("users")
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  documents Document[]
  sharedWith FolderAccess[]

  parentId    String? 
  parent      Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders  Folder[] @relation("FolderHierarchy")

  privacy      PrivacyLevel   @default(PRIVATE)
  shareToken   String?        @unique

  isArchived   Boolean        @default(false) // Tambahkan ini
  deletedAt    DateTime?      // Tambahkan ini untuk tracking kapan diarsip

  createdAt DateTime   @default(now())
  updatedAt    DateTime @updatedAt 

  @@map("folders")
}

model Document {
  id           String   @id @default(uuid())
  title        String
  description  String?
  fileName     String
  fileSize     Int
  mimeType     String
  ipfsHash     String   @unique
  fileHash     String   @unique
  blockchainTx String
  isOnChain    Boolean  @default(false)
  
  privacy      PrivacyLevel @default(PRIVATE)
  
  isArchived   Boolean  @default(false)
  deletedAt    DateTime? 

  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id])

  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])

  sharedWith   DocumentAccess[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt 

  @@map("documents")
}

model DocumentAccess {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([documentId, userId]) // Mencegah duplikasi akses
  @@map("document_access")
}

model FolderAccess {
  id        String   @id @default(uuid())
  folderId  String
  userId    String
  
  folder    Folder   @relation(fields: [folderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  role AccessRoleFolder @default(VIEWER)

  createdAt DateTime @default(now())

  @@unique([folderId, userId]) // Mencegah duplikasi akses pada folder yang sama
  @@map("folder_access")
}

model ActivityLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  action        String   // Contoh: "UPLOAD", "MOVE", "DELETE", "RESTORE", "SHARE"
  entityType    String   // "DOCUMENT" atau "FOLDER"
  entityId      String   // ID Dokumen/Folder terkait
  entityName    String   // Nama file/folder (Penting buat history kalau aslinya sudah dihapus)
  
  // Data Blockchain (Diisi jika aksi berkaitan dengan file, misal UPLOAD/DELETE)
  fileHash      String?
  ipfsHash      String?
  blockchainTx  String?
  
  details       String?  // Info tambahan, misal: "Moved to folder Research"
  createdAt     DateTime @default(now())

  @@map("activity_logs")
}
