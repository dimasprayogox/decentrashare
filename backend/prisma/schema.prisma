// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PrivacyLevel {
  PRIVATE
  PUBLIC
  LINK_ONLY
  SPECIFIC_USER
}

enum AccessRoleFolder {
  VIEWER
  EDITOR
}

model User {
  id              String    @id @default(uuid())
  walletAddress   String    @unique
  username        String?   @unique
  email           String?   @unique
  avatarUrl       String?
  role            Role      @default(USER)
  isRegistered    Boolean   @default(false)
  nonce           String?
  nonceExpiresAt  DateTime?
  refreshToken    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  documents       Document[]
  folders         Folder[]
  sharedDocuments DocumentAccess[]
  sharedFolders   FolderAccess[]

  @@map("users")
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  documents Document[]
  sharedWith FolderAccess[]

  privacy      PrivacyLevel   @default(PRIVATE)
  shareToken   String?        @unique

  isArchived   Boolean        @default(false) // Tambahkan ini
  deletedAt    DateTime?      // Tambahkan ini untuk tracking kapan diarsip

  createdAt DateTime   @default(now())
  
  

  @@map("folders")
}

model Document {
  id           String   @id @default(uuid())
  title        String
  description  String?
  fileName     String
  fileSize     Int
  mimeType     String
  ipfsHash     String   @unique
  fileHash     String   @unique
  blockchainTx String
  isOnChain    Boolean  @default(false)
  
  privacy      PrivacyLevel @default(PRIVATE)
  
  isArchived   Boolean  @default(false)
  deletedAt    DateTime? 

  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id])

  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])

  sharedWith   DocumentAccess[]

  createdAt    DateTime @default(now())

  @@map("documents")
}

model DocumentAccess {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId]) // Mencegah duplikasi akses
  @@map("document_access")
}

model FolderAccess {
  id        String   @id @default(uuid())
  folderId  String
  userId    String
  
  folder    Folder   @relation(fields: [folderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  role AccessRoleFolder @default(VIEWER)

  createdAt DateTime @default(now())

  @@unique([folderId, userId]) // Mencegah duplikasi akses pada folder yang sama
  @@map("folder_access")
}